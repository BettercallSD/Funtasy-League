// Prisma schema for Ball Knowledge.
// See CLAUDE.md "Core data model" for the source of truth on why these
// fields exist (especially the season-versioned config on Season, and the
// guest-prediction boundary on Prediction/User).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SeasonStatus {
  UPCOMING // created, predictions not yet open
  OPEN // predictions open, before predictionLockAt
  LOCKED // predictionLockAt has passed, season in progress
  FINALIZED // SeasonResult entered, scores locked in
}

enum AwardCategory {
  GOLDEN_BOOT
  MOST_ASSISTS
  YOUNG_PLAYER
  SURPRISE_TEAM
  DISAPPOINTING_TEAM
  EMERGING_PLAYER
}

// ---------------------------------------------------------------------------
// League / Season / Team / Player
// ---------------------------------------------------------------------------

model League {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  accentColor String
  createdAt   DateTime @default(now())

  seasons Season[]
}

model Season {
  id       String @id @default(cuid())
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId String

  year Int

  // Admin-configured per season — never hardcode these, formats change year to year.
  // European slots are broken out per competition (not one vague "Europe"
  // count) since UCL/Europa/Conference counts shift independently with UEFA
  // coefficient rules; the sum of the three is the scoring engine's
  // "top-bracket" slot count from CLAUDE.md's scoring table.
  teamCount              Int
  directRelegationCount  Int
  playoffRelegationCount Int
  championsLeagueSlots   Int
  europaLeagueSlots      Int
  conferenceLeagueSlots  Int

  predictionLockAt DateTime
  status           SeasonStatus @default(UPCOMING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasonTeams   SeasonTeam[]
  predictions   Prediction[]
  seasonResult  SeasonResult?
  friendLeagues FriendLeagueSeason[]
  snapshot      SeasonSnapshot?

  @@unique([leagueId, year])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  shortName String?
  crestUrl  String?
  createdAt DateTime @default(now())

  seasonTeams            SeasonTeam[]
  players                Player[]
  predictionTableEntries PredictionTableEntry[]
  predictionAwards       PredictionAward[]
  seasonResultEntries    SeasonResultTableEntry[]
  seasonResultAwards     SeasonResultAward[]

  @@unique([name])
}

// Which teams are in which league that season, and whether they were
// promoted/relegated into/out of that spot. Season-versioned so a team's
// membership (and status) is never assumed constant across years.
model SeasonTeam {
  id       String @id @default(cuid())
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String

  promoted  Boolean @default(false)
  relegated Boolean @default(false)

  @@unique([seasonId, teamId])
}

model Player {
  id             String @id @default(cuid())
  name           String
  // Lowercased, diacritic-stripped copy of name (see lib/normalize-name.ts) —
  // lets search match "mbappe" against "Mbappé" via Prisma's query builder
  // instead of a raw-SQL unaccent() call, which CLAUDE.md's security rules
  // forbid.
  normalizedName String
  dateOfBirth    DateTime
  position       String?

  currentTeam   Team?   @relation(fields: [currentTeamId], references: [id], onDelete: SetNull)
  currentTeamId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  predictionAwards   PredictionAward[]
  seasonResultAwards SeasonResultAward[]
  topScorerSnapshots SeasonSnapshot[]    @relation("SnapshotTopScorer")

  @@index([name])
  @@index([normalizedName])
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id       String  @id @default(cuid())
  googleId String  @unique
  email    String  @unique
  name     String?
  image    String?
  isAdmin  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  predictions             Prediction[]         @relation("UserPredictions")
  claimedPrediction       Prediction?          @relation("ClaimedPrediction")
  friendLeaguesCreated    FriendLeague[]       @relation("FriendLeagueCreator")
  friendLeagueMemberships FriendLeagueMember[]
}

// ---------------------------------------------------------------------------
// Predictions
// ---------------------------------------------------------------------------

model Prediction {
  id       String @id @default(cuid())
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId String

  // Real (signed-in) predictions set userId and leave guestToken null.
  // Guest predictions set guestToken and leave userId null. isGuest mirrors
  // this so every aggregate/scoring query can filter on one boolean instead
  // of re-deriving it from nullability.
  user       User?   @relation("UserPredictions", fields: [userId], references: [id], onDelete: Cascade)
  userId     String?
  isGuest    Boolean @default(false)
  guestToken String? @unique

  // A guest prediction can be claimed as personal history by exactly one
  // user, ever. The @unique on claimedByUserId enforces "one claimable
  // guest prediction per account" at the database level, not just in code.
  claimedBy       User?     @relation("ClaimedPrediction", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  claimedByUserId String?   @unique
  claimed         Boolean   @default(false)
  claimedAt       DateTime?

  // Label like "Predicted after GW1" for guest result cards, computed at
  // submission time from the season's matchday schedule.
  submittedLabel String?

  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Locked in permanently at season finalize, computed by lib/scoring.ts
  // against SeasonResult. Null until the season is finalized.
  finalScore               Int?
  finalScoreBreakdown      Json?
  finalExactBonusCount     Int?
  // Recomputed by the standings-sync cron against the latest SeasonSnapshot
  // — "if the season ended today" scoring, shown on the live leaderboard.
  projectedScore           Int?
  projectedScoreBreakdown  Json?
  projectedExactBonusCount Int?
  projectedScoreUpdatedAt  DateTime?

  tableEntries PredictionTableEntry[]
  awards       PredictionAward[]

  @@unique([userId, seasonId])
  @@index([seasonId, isGuest])
}

model PredictionTableEntry {
  id           String     @id @default(cuid())
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  predictionId String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String

  predictedPosition Int

  @@unique([predictionId, teamId])
  @@unique([predictionId, predictedPosition])
}

// One row per award category per prediction. Exactly one of playerId /
// teamId is set, depending on whether `category` is a player-based award
// (Golden Boot, Most Assists, Young Player, EMERGING_PLAYER — the enum value
// is unchanged from an earlier naming, but this is the "Player of the
// Season" category now) or a team-based award (Surprise Team, Disappointing
// Team) — enforced in the Zod schema at the API boundary, not at the DB level.
model PredictionAward {
  id           String        @id @default(cuid())
  prediction   Prediction    @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  predictionId String
  category     AwardCategory

  player   Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String?
  team     Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String?

  @@unique([predictionId, category])
}

// ---------------------------------------------------------------------------
// Season results (ground truth used to score every prediction)
// ---------------------------------------------------------------------------

model SeasonResult {
  id       String @id @default(cuid())
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId String @unique

  finalizedAt       DateTime @default(now())
  finalizedByUserId String

  tableEntries SeasonResultTableEntry[]
  awards       SeasonResultAward[]
}

model SeasonResultTableEntry {
  id             String       @id @default(cuid())
  seasonResult   SeasonResult @relation(fields: [seasonResultId], references: [id], onDelete: Cascade)
  seasonResultId String
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId         String

  finalPosition Int

  @@unique([seasonResultId, teamId])
  @@unique([seasonResultId, finalPosition])
}

// Award winners at season finalization. For SURPRISE_TEAM / DISAPPOINTING_TEAM
// the average*/actual* fields hold the computed community-expectation math
// so it can be displayed on the result page ("Community expected 8th,
// finished 3rd"); isManualOverride flags when the admin overrode the
// auto-calculation.
model SeasonResultAward {
  id             String        @id @default(cuid())
  seasonResult   SeasonResult  @relation(fields: [seasonResultId], references: [id], onDelete: Cascade)
  seasonResultId String
  category       AwardCategory

  player   Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String?
  team     Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String?

  averagePredictedPosition Float?
  actualPosition           Int?
  isManualOverride         Boolean @default(false)

  @@unique([seasonResultId, category])
}

// A periodically-refreshed cache of "current" standings/top-scorer data
// pulled from football-data.org (Vercel Cron), used to compute every locked
// prediction's *projected* score without touching the external API on every
// page load. One row per season, overwritten in place each sync — this is
// disposable derived data, not a historical record, so no snapshot history
// is kept. `standings` is a JSON array of { teamId, position } rather than a
// relation table since it's wholesale-replaced on every sync, not queried
// piecemeal.
model SeasonSnapshot {
  id       String @id @default(cuid())
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId String @unique

  fetchedAt DateTime @default(now())
  standings Json

  topScorer   Player? @relation("SnapshotTopScorer", fields: [topScorerId], references: [id], onDelete: SetNull)
  topScorerId String?
}

// ---------------------------------------------------------------------------
// Friend leagues
// ---------------------------------------------------------------------------

model FriendLeague {
  id        String @id @default(cuid())
  creator   User   @relation("FriendLeagueCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  name       String
  inviteCode String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasons FriendLeagueSeason[]
  members FriendLeagueMember[]
}

// A friend league can be scoped to one or several seasons, chosen at
// creation time. Points are only ever summed within this exact scope.
model FriendLeagueSeason {
  id             String       @id @default(cuid())
  friendLeague   FriendLeague @relation(fields: [friendLeagueId], references: [id], onDelete: Cascade)
  friendLeagueId String
  season         Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId       String

  @@unique([friendLeagueId, seasonId])
}

model FriendLeagueMember {
  id             String       @id @default(cuid())
  friendLeague   FriendLeague @relation(fields: [friendLeagueId], references: [id], onDelete: Cascade)
  friendLeagueId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  joinedAt DateTime @default(now())

  @@unique([friendLeagueId, userId])
}

// ---------------------------------------------------------------------------
// Rate limiting
// ---------------------------------------------------------------------------

// Backs lib/rate-limit.ts. A DB-backed limiter (not in-memory) because
// Vercel serverless functions don't share memory across instances — this is
// the only source of truth that's actually consistent in that environment.
// `key` is a scope+identity string, e.g. "friend-league-join:203.0.113.4".
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
