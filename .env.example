# Neon PostgreSQL connection string (Project Settings > Connection Details on neon.tech).
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application).
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Auth.js session encryption secret — generate with `npx auth secret` or `openssl rand -base64 32`.
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Base URL of the deployed app (e.g. http://localhost:3000 in dev, your Vercel URL in prod).
NEXTAUTH_URL="http://localhost:3000"

# football-data.org free-tier API key, used to pull live standings/scorers (10 req/min limit).
FOOTBALL_DATA_API_KEY="your-football-data-org-api-key"

# Secret Vercel Cron sends as a Bearer token to authenticate calls to
# /api/cron/sync-standings — generate with `openssl rand -base64 32`. Set the
# same value in Vercel's project env vars; Vercel then attaches it
# automatically to cron-triggered requests.
CRON_SECRET="replace-with-a-random-secret"

# Cloudflare Turnstile keys, used to gate guest (no-login) prediction submissions.
TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"
